# Copy to .env and fill in values.

# Required for chat / LLM (Groq — free tier available)
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: base URL (defaults to Groq OpenAI-compatible endpoint)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Required: JWT secret for authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides
# DEBUG=false

# CORS: JSON array of origins, or use defaults from config.py
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# OCR: set true only if CUDA is available
# OCR_USE_GPU=false

# Max image upload size for /api/medicine/scan
# MAX_UPLOAD_IMAGE_MB=10
