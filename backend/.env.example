# Copy to .env and fill in values.

# Required for chat / LLM
GROQ_API_KEY=

# Optional overrides
# DEBUG=false
# GROQ_MODEL=qwen/qwen3-32b
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# CORS: JSON array of origins, or use defaults from config.py
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# OCR: set true only if CUDA is available
# OCR_USE_GPU=false

# Max image upload size for /api/medicine/scan
# MAX_UPLOAD_IMAGE_MB=10
